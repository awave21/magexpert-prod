acing=10;dashPattern=8 4;metaEdit=1;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1120" height="860" as="geometry"/></mxCell><mxCell id="c-staff" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Сотрудник MagExpert&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;Готовит и запускает рассылки&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;resizable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="0" width="200" height="180" as="geometry"/></mxCell><mxCell id="c-doctor" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Врач&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;Пользуется сайтом, получает письма&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;resizable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="0" width="200" height="180" as="geometry"/></mxCell><mxCell id="c-apps" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Внешние приложения&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;CRM и другие проекты&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;resizable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="30" width="240" height="120" as="geometry"/></mxCell><mxCell id="spa" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Админка Sender — фронтенд&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: React 19 SPA, в браузере]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;Статика с mail.mag-expert.ru; данные берёт только через REST API&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="240" height="120" as="geometry"/></mxCell><mxCell id="site" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Сайт MagExpert — фронтенд&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Vue 3 + Inertia, в браузере]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;Страницы сайта, кабинет, галочка рассылки&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="460" y="300" width="240" height="120" as="geometry"/></mxCell><mxCell id="db" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: magexpert_sender]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;Письма, события, базы, рассылки, блок-лист, журнал&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;resizable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="490" width="240" height="140" as="geometry"/></mxCell><mxCell id="app" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Бэкенд: Laravel-приложение&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: PHP 8.4, Laravel 11]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;Сайт и модуль Sender: REST API, Inertia, трекинг, отписка&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="460" y="500" width="240" height="120" as="geometry"/></mxCell><mxCell id="scheduler" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Планировщик&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: cron, schedule:run]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;Пачки, mail.log, зависшие письма, жалобы, алерты&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="500" width="240" height="120" as="geometry"/></mxCell><mxCell id="worker-c" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Воркер рассылок&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: queue:work, supervisor]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#E6E6E6"&gt;Очередь sender: рассылки, подготовка баз, проверка адресов, вебхуки&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="240" height="120" as="geometry"/></mxCell><mxCell id="redis" value='&lt;font style="font-size: 15px"&gt;&lt;b&gt;Redis&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: две о