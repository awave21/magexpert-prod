flowchart TB
  spa["<b>Админка</b><br/>[Container: React]"]:::container
  site["<b>Код сайта</b><br/>[Container: Laravel]<br/>SenderMailService"]:::ext

  subgraph module["Модуль app/Sender"]
    adminApi["<b>Админ-API</b><br/>[Component: Controllers]<br/><br/>Роли и журнал действий"]:::component
    campaigns["<b>CampaignService</b><br/>[Component]<br/><br/>Запуск, пачки,<br/>пауза, отмена"]:::component
    schedule["<b>CampaignSchedule, Warmup</b><br/>[Component]<br/><br/>Окно МСК, прогрев IP"]:::component
    subscriptions["<b>SubscriptionService</b><br/>[Component]<br/><br/>Отписка, база с сайта"]:::component
    messages["<b>MessageService</b><br/>[Component]<br/><br/>Проверки, блок-лист,<br/>лимиты, очередь"]:::component
    jobs["<b>SendMessageJob</b><br/>[Component]<br/><br/>Захват письма,<br/>заголовки FBL"]:::component
    delivery["<b>MailLog, Complaint</b><br/>[Component]<br/><br/>Статусы, жалобы"]:::component
    monitoring["<b>HealthMonitor, Webhooks</b><br/>[Component]<br/><br/>Алерты, события"]:::component
  end

  redis[["<b>Redis</b><br/>[Queue]"]]:::container
  postfix["<b>Postfix</b><br/>[Container]"]:::container

  spa -- "JSON" --> adminApi
  site -- "Служебные письма" --> messages
  site -- "Согласие" --> subscriptions
  adminApi --> campaigns
