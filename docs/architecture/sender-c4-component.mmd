  campaigns -- "Готовит письма" --> messages
  campaigns -- "Обновляет базу" --> subscriptions
  messages --> redis
  redis --> jobs
  jobs -- "SMTP" --> postfix
  postfix -. "mail.log" .-> delivery
  delivery -- "Блок после жалобы" --> subscriptions
  delivery -- "События" --> monitoring
