APP_NAME="МедАльянсГрупп Expert"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=MagExpert
DB_USERNAME=UserMagExpert
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
AUTH_REMEMBER_MINUTES=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.mag-expert.ru
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
BROADCAST_DRIVER=reverb
QUEUE_CONNECTION=redis

CACHE_STORE=database
CACHE_DRIVER=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_AUTO_TLS=true
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=352443788
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=6002
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=6002
REVERB_SERVER_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Вход через Яндекс ID (oauth.yandex.ru) и VK ID (id.vk.com/business).
# Адреса возврата: https://<домен сайта>/auth/yandex/callback и https://<домен сайта>/auth/vkid/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VKID_CLIENT_ID=
VKID_CLIENT_SECRET=
# true — запрашивать телефон (включите доступ к номеру в приложениях Яндекса и ВК)
YANDEX_PHONE=false
VKID_PHONE=false

DADATA_TOKEN=
DADATA_SECRET=

PAYKEEPER_ENABLED=true
PAYKEEPER_SERVER_URL=https://medalliance-expert.server.paykeeper.ru/
PAYKEEPER_USERNAME=medalliance-expert-api
PAYKEEPER_PASSWORD=
PAYKEEPER_TEST_MODE=false
PAYKEEPER_WEBHOOK_SECRET=


# Основные настройки подключения к Sendsay API
SENDSAY_API_URL=https://api.sendsay.ru/general/api/v100/json/x_1683190020998751
SENDSAY_LOGIN=
SENDSAY_SUBLOGIN=
SENDSAY_PASSWORD=

# Приветственное письмо для новых пользователей
SENDSAY_DRAFT_WELCOME=
# Письмо с восстановлением пароля
SENDSAY_DRAFT_PASSWORD_RESET=539
# Подтверждение заказа покупателю
SENDSAY_DRAFT_ORDER_CONFIRMATION=

# Письмо о регистрации на мероприятие
SENDSAY_DRAFT_EVENT_REGISTRATION=542

# Уведомление покупателю об оплаченном заказе
SENDSAY_DRAFT_ORDER_PAID_CUSTOMER=
# Уведомление руководителям об оплаченном заказе
SENDSAY_DRAFT_ORDER_PAID_MANAGERS=
# Промо письмо с предложениями
SENDSAY_DRAFT_PROMOTIONAL=

# Группа покупателей
SENDSAY_GROUP_CUSTOMERS=
# Группа подписчиков на рассылку
SENDSAY_GROUP_SUBSCRIBERS=


# Включить логирование (true/false)
SENDSAY_LOGGING_ENABLED=true
# Уровень логирования (debug, info, warning, error)
SENDSAY_LOGGING_LEVEL=debug
# Количество дней хранения логов
SENDSAY_LOG_DAYS=7
# Логировать запросы к API (true/false)
SENDSAY_LOG_REQUESTS=true
# Логировать ответы от API (true/false)
SENDSAY_LOG_RESPONSES=true

# Задержка между отправкой писем (миллисекунды)
SENDSAY_DELAY_BETWEEN_EMAILS=100
# Максимальное количество повторных попыток при ошибке
SENDSAY_MAX_RETRIES=3
# Задержка между повторными попытками (миллисекунды)
SENDSAY_RETRY_DELAY=1000


BITRIX24_WEBHOOK_URL=
BITRIX24_DEAL_CATEGORY_ID=5
BITRIX24_EVENT_ENTITY_TYPE_ID=1040
BITRIX24_ASSIGNED_BY_ID=41
# Статус смарт‑процесса («Оплачено»/«Ожидает оплаты»)
BITRIX24_EVENT_UF_STATUS=UF_CRM_15_STATUS
BITRIX24_LOGGING_LEVEL=debug

BITRIX24_DEAL_TYPE_ID=SALE
BITRIX24_EVENT_UNIQUE=false
BITRIX24_RETRY_TIMES=3
BITRIX24_RETRY_SLEEP_MS=250
BITRIX24_TIMEOUT=15
BITRIX24_CONNECT_TIMEOUT=5
BITRIX24_UF_CITY=UF_CRM_ITS_DICT_CITY
BITRIX24_UF_POST=UF_CRM_POST
BITRIX24_UF_SPECIALIZATION=UF_CRM_1642077639
BITRIX24_UF_FORMAT=UF_CRM_1719829830428

# Дата/время начала
BITRIX24_EVENT_UF_DATE_START=UF_CRM_15_DATE_START
# Формат (будет маппиться на «Онлайн»/«Офлайн»/«Гибридный»)
BITRIX24_EVENT_UF_FORMAT=UF_CRM_15_FORMAT
# Спикеры (строка из ФИО через запятую)
BITRIX24_EVENT_UF_SPEAKERS=UF_CRM_15_SPEAKERS

# UF поля контакта/сделки
BITRIX24_UF_CITY=UF_CRM_ITS_DICT_CITY
BITRIX24_UF_POST=UF_CRM_POST
BITRIX24_UF_SPECIALIZATION=UF_CRM_1642077639
BITRIX24_UF_FORMAT=UF_CRM_1719829830428

# Источник
BITRIX24_SOURCE_ID=WEB
BITRIX24_SOURCE_DESCRIPTION='Регистрация на мероприятие'

# Переводы стадий сделки отключены
# BITRIX24_DEAL_STAGE_REGISTERED=
# BITRIX24_DEAL_STAGE_PAID=
# Sender service database (separate Postgres database)
SENDER_DB_DATABASE=magexpert_sender

# Как сайт отправляет письма через Sender:
# http — через открытый API Sender по ключу организации (как любой внешний клиент), local — напрямую внутри приложения
SENDER_CLIENT_DRIVER=local
SENDER_ORGANIZATION=magexpert
# для http: адрес Sender (например https://mail.mag-expert.ru) и API-ключ из раздела «API-ключи»
SENDER_API_URL=
SENDER_API_KEY=
SENDER_FROM_ADDRESS=noreply@mag-expert.ru
SENDER_FROM_NAME="МедАльянсГрупп Expert"
# шаблоны писем сайта: ключ шаблона (алиас) или его ID в Sender
SENDER_TEMPLATE_WELCOME=welcome
SENDER_TEMPLATE_EMAIL_CONFIRMATION=email-confirmation
SENDER_TEMPLATE_PASSWORD_RESET=password-reset
SENDER_TEMPLATE_PASSWORD_RESET_LINK=password-reset-link
SENDER_TEMPLATE_EVENT_REGISTRATION=event-registration
SENDER_TEMPLATE_API_REGISTRATION=api-registration

# IP сервера отправки для SPF и адрес почтового хоста
SENDER_SERVER_IP=
SENDER_MAIL_HOST=mail.mag-expert.ru

# Адрес админки Sender на своём поддомене; пусто — админка по /sender
SENDER_UI_URL=
SENDER_MAIL_LOG=/var/log/mail.log
SENDER_RETENTION_DAYS=365
